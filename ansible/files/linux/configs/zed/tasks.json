[
  // --- GODOT (.NET / C#) ---
  {
    "label": "  godot: build",
    "command": "dotnet build /property:GenerateFullPaths=true /consoleloggerparameters:NoSummary",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "on_success"
  },
  {
    "label": "   godot: run",
    "command": "dotnet build /property:GenerateFullPaths=true /consoleloggerparameters:NoSummary && \"${GODOT:-/usr/sbin/godot-mono}\" --path \"$ZED_WORKTREE_ROOT\"",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always"
  },

  // --- FLUTTER / DART ---
  {
    "label": "   flutter: run (linux)",
